Cel: przykład wymaganych zmiennych środowiskowych.

Polecenie do implementacji:

Wypisz kompletną listę zmiennych, np:

APP_ENV=development
APP_URL=https://symulatorvectron.pl
DB_DSN=mysql:host=127.0.0.1;dbname=vectron
SMTP_HOST=...
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SMTP_FROM=symulator@kgrail.pl
P24_POS_ID=...
P24_CRC=...
P24_TEST=true
ADMIN_EMAIL=admin@symulator.pl
TIMEZONE=Europe/Warsaw

Dla każdego wpisu dodaj krótką uwagę w komentarzu co to znaczy.

# ---------------------------
# DATABASE CONFIG
# ---------------------------
DB_HOST=127.0.0.1
DB_NAME=v
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4_polish_ci

# ---------------------------
# ADMIN LOGIN DEFAULT
# ---------------------------
ADMIN_USERNAME=admin
# Hasło w postaci jawnej tylko w przykładzie. W produkcji używaj hash(password)
ADMIN_PASSWORD=changeme

# ---------------------------
# SMTP MAIL CONFIG
# ---------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=Booking System

# ---------------------------
# P24 CONFIG
# ---------------------------
P24_MERCHANT_ID=your_merchant_id
P24_POS_ID=your_pos_id
P24_CRC=your_crc_key
P24_SANDBOX=true   # true = testowe środowisko, false = produkcja

# ---------------------------
# SECURITY / CSRF
# ---------------------------
CSRF_SECRET=put_a_random_secret_here

# ---------------------------
# OTHER SETTINGS
# ---------------------------
DEFAULT_DURATION_MINUTES=60
TIMEZONE=Europe/Warsaw

# -------------------------
# APLIKACJA / ŚRODOWISKO
# -------------------------
APP_ENV=production                # production | staging | development
APP_DEBUG=false                   # true tylko w dev (nie w prod)
APP_URL=https://symulatorvectron.pl
APP_TIMEZONE=Europe/Warsaw        # strefa czasowa serwera, np. Europe/Warsaw

# Bezpieczny losowy klucz aplikacji (np. do szyfrowania cookie / tokenów)
# Wygeneruj długi losowy ciąg (np. openssl rand -base64 32)
APP_KEY=changeme_replace_with_real_key

# -------------------------
# BAZA DANYCH (PDO / DSN)
# -------------------------
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=booking_db
# Opcjonalnie możesz podać pełny DSN:
# DB_DSN=mysql:host=127.0.0.1;dbname=booking_db;charset=utf8mb4

# -------------------------
# PRZELEWY24 (PŁATNOŚCI)
# -------------------------
PRZELEWY24_MERCHANT_ID=123456
PRZELEWY24_POS_ID=123456
PRZELEWY24_CRC=your_crc_key_here          # CRC / secret z panelu Przelewy24
PRZELEWY24_API_KEY=your_api_key_here      # API key (dla Basic Auth)
PRZELEWY24_REGISTER_URL=https://secure.przelewy24.pl/api/v1/transaction/register
PRZELEWY24_REDIRECT_TEMPLATE=https://secure.przelewy24.pl/trnRequest/{TOKEN}
PRZELEWY24_SANDBOX=true                   # true = korzystaj z sandboxu (dev), false = prod

# URL-e używane w start-payment.php (zwracane do bramki)
PAYMENT_RETURN_URL=https://symulatorvectron.pl/payment-return
PAYMENT_NOTIFY_URL=https://symulatorvectron.pl/payment-callback

# Algorytm podpisu (jeśli używasz innego sposobu)
PRZELEWY24_SIGN_METHOD=json                # json | concat

# -------------------------
# MAIL / SMTP (wysyłka potwierdzeń)
# -------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=smtp_user
MAIL_PASSWORD=smtp_password
MAIL_ENCRYPTION=tls                        # tls | ssl | null
MAIL_FROM_ADDRESS=info@symulatorvectron.pl
MAIL_FROM_NAME="Symulator Vectron"

# -------------------------
# ADMIN / PANEL
# -------------------------
ADMIN_EMAIL=admin@symulatorvectron.pl
# Nie przechowuj w repo hasła jawnie — utwórz admina podczas deployu.
ADMIN_PASSWORD_PLACEHOLDER=do-not-commit

# -------------------------
# REZERWACJE / VOUCHERY / LIMITY
# -------------------------
MAX_PARTICIPANTS=10
DEFAULT_SLOT_DURATION_MINUTES=60
BUFFER_MINUTES=10                          # przerwa pomiędzy sesjami
RESERVATION_EXPIRES_IN=900                # czas (s), po którym pending reservation wygasa (np. 900 = 15min)
VOUCHER_RESERVATION_EXPIRES_IN=900        # czas rezerwacji vouchera (sekundy)
RATE_LIMIT_PER_HOUR=10                    # limit rezerwacji na email / godzinę

# -------------------------
# FRONTEND / CORS / HOSTING
# -------------------------
FRONTEND_URL=https://symulatorvectron.pl
CORS_ALLOWED_ORIGINS=https://symulatorvectron.pl,https://admin.symulatorvectron.pl

# -------------------------
# LOGI / MONITORING
# -------------------------
LOG_CHANNEL=stack
LOG_LEVEL=info

# -------------------------
# SSL / CERT (opcjonalne, jeśli potrzebujesz ścieżek do certyfikatów)
# -------------------------
SSL_CERT_PATH=/etc/ssl/certs/fullchain.pem
SSL_KEY_PATH=/etc/ssl/private/privkey.pem

# -------------------------
# INNE / BEZPIECZEŃSTWO
# -------------------------
# Secret do podpisywania tokenów / webhooków (np. jeśli generujesz własne HMAC)
WEBHOOK_SECRET=replace_with_random_secret
# Do obsługi X-Forwarded-For / proxy
TRUSTED_PROXIES=127.0.0.1,::1

# -------------------------
# KONFIGURACJA DLA DEV / LOKALNEGO ŚRODOWISKA
# -------------------------
# Ustaw PRZELEWY24_SANDBOX=true, PRZELEWY24_REGISTER_URL na sandbox, MAIL_* na dev SMTP (Mailtrap) i APP_DEBUG=true

P24_SIGNATURE_KEY=
P24_SECRET_KEY=
P24_GATEWAY_IP=






DB_DSN=mysql:host=127.0.0.1;dbname=vectron;charset=utf8mb4


P24_SIGNATURE_KEY=
P24_SECRET_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=


APP_ENV=development
APP_URL=

# DB (przykład MySQL)
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=vectron_sim;charset=utf8mb4



# Przelewy24
P24_SECRET_KEY=xxxxxxxxxxxxxxxx
P24_SIGNATURE_KEY=yyyyyyyyyyyyyyyy

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASS=smtp_pass
MAIL_FROM_ADDRESS=info@symulatorvectron.pl

# ADMIN
ADMIN_EMAIL=admin@symulatorvectron.pl
